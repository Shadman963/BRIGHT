# ==============================================================================
# BRIGHT EDU CONSULTANCY - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your production values.

# ----------------- Core Django Settings -----------------
# In production, set DEBUG=False. In local development, set DEBUG=True.
DEBUG=False

# Generate a unique, random 50+ character secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=generate-a-secure-random-secret-key-for-production-here-min-50-chars

# Comma-separated list of host/domain names that this Django site can serve:
ALLOWED_HOSTS=brighteduconsultancy.com,www.brighteduconsultancy.com,127.0.0.1,localhost

# CSRF Trusted Origins for HTTPS form submissions (Django 4.0+)
CSRF_TRUSTED_ORIGINS=https://brighteduconsultancy.com,https://www.brighteduconsultancy.com

# ----------------- Database Settings -----------------
# Optional: Set DATABASE_URL to use PostgreSQL, MySQL, etc.
# Examples:
#   PostgreSQL: postgresql://user:password@localhost:5432/bright_edu_db
#   MySQL:      mysql://user:password@localhost:3306/bright_edu_db
# If left unset, defaults to local SQLite: sqlite:///db.sqlite3
# DATABASE_URL=postgresql://bright_user:strong_password@localhost:5432/bright_edu_prod

# ----------------- Security & HTTPS Settings -----------------
# Enable automatic HTTP to HTTPS redirect behind SSL termination:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ----------------- Static & Media Serving -----------------
# WhiteNoise automatically serves static files.
# Allow Django to serve media uploads in standalone container/VPS setups:
SERVE_MEDIA_FILES=True

# ----------------- Email / SMTP Settings -----------------
# In development: 'django.core.mail.backends.console.EmailBackend'
# In production:  'django.core.mail.backends.smtp.EmailBackend'
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=admissions@brighteduconsultancy.com
EMAIL_HOST_PASSWORD=your-secure-app-password
DEFAULT_FROM_EMAIL=Bright Edu Consultancy <admissions@brighteduconsultancy.com>

# ----------------- Logging Level -----------------
DJANGO_LOG_LEVEL=INFO

# ----------------- Consultancy Information -----------------
CONSULTANCY_NAME=Bright Edu Consultancy
CONSULTANCY_TAGLINE=Your Gateway to Global Education & China Scholarships
CONSULTANCY_PHONE=+880 1712 345678
CONSULTANCY_WHATSAPP=+8801712345678
CONSULTANCY_WHATSAPP_DISPLAY=+880 1712-345678
CONSULTANCY_WECHAT=BrightEdu_China
CONSULTANCY_EMAIL=info@brighteduconsultancy.com
CONSULTANCY_ADMISSIONS_EMAIL=admissions@brighteduconsultancy.com
CONSULTANCY_MAIN_OFFICE=Suite 701, Green Horizon Tower, Panthapath, Dhaka-1205
CONSULTANCY_CHINA_OFFICE=Building 4, Science Park, Pudong New Area, Shanghai, China
CONSULTANCY_OFFICE_HOURS=Sat - Thu: 9:30 AM - 6:30 PM (Friday Closed)
CONSULTANCY_FACEBOOK_URL=https://facebook.com/brighteduconsultancy
CONSULTANCY_INSTAGRAM_URL=https://instagram.com/brighteduconsultancy
CONSULTANCY_LINKEDIN_URL=https://linkedin.com/company/bright-edu-consultancy
